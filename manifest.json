{
  "manifest_version": 2,
  "name": "AI Chat Exporter \u2192 for Nextcloud",
  "version": "1.0.0",
  "description": "Auto-exports AI chat conversations to Markdown files on your Nextcloud instance, with delimiter cropping, regex masking, and de-duplicated append-updates.",
  "icons": { "48": "icons/icon-48.png" },
  "permissions": [
    "storage",
    "notifications",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["lib.js", "background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon-48.png",
    "default_title": "AI Chat Exporter"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-exporter-to-nextcloud-firefox@local.dev",
      "strict_min_version": "102.0"
    }
  }
}
